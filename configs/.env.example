TARGET_URL=https://example.com/health
METHOD=GET
DURATION=30s
MAX_CONCURRENCY=20
RAMP_UP_SECONDS=10
REQUEST_TIMEOUT_MS=3000
MAX_QPS=100
ALLOW_HOSTS=example.com,api.example.com
REQUEST_HEADERS=User-Agent:HiveRunLoadTester/1.0;Accept:application/json
REQUEST_BODY=
STOP_ON_ERROR_RATE=0.40
STOP_ON_TIMEOUT_RATE=0.25
MIN_SAMPLES_BEFORE_STOP=20
RETRY_COUNT=0
RETRY_BACKOFF_MS=200
REPORT_DIR=reports
REPORT_JSON_PATH=
REPORT_CSV_PATH=
